{
  "short_name": "Mineo",
  "name": "Mineo Erstatningsberegner",
  "id": "https://mineo.dk/",
  "icons": [
    {
      "src": "/icons/mineo-icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/mineo-icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/favicon-mineo.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "start_url": "/",
  "scope": "/",
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://mineo.dk/manifest.json",
      "id": "https://mineo.dk/"
    }
  ],
  "display": "standalone",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+mineo",
      "url": "/?mineo-launch=%s"
    }
  ],
  "theme_color": "#e9ecef",
  "background_color": "#ffffff",
  "file_handlers": [
    {
      "action": "/open",
      "accept": {
        "application/x-eo": [".eo"],
        "application/octet-stream": [".eo"],
        "application/json": [".eo"]
      },
      "icons": [
        { "src": "/icons/mineo-icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "/icons/mineo-icon-512.png", "sizes": "512x512", "type": "image/png" }
      ]
    }
  ]
}
