{
  "name": "mineo",
  "version": "0.9.5-a",
  "description": "Mineo - Web-baseret erstatningsberegner til EAL- og ASL-opgørelser",
  "author": "Bjørn Elling",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BjornElling/mineo.git"
  },
  "keywords": [
    "erstatning",
    "erstatningsopgørelse",
    "erstatningsberegner",
    "EAL",
    "erstatningsansvarsloven",
    "ASL",
    "arbejdsskadesikringsloven"
  ],
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/montserrat": "^5.2.8",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "docx": "^9.7.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "scripts": {
    "dev": "vite --config vite.mineo.config.ts --open /",
    "dev:minprocesrente": "vite --config vite.minprocesrente.config.ts --open /minprocesrente.html",
    "build": "npm run build:mineo",
    "build:mineo": "vite build --config vite.mineo.config.ts && node scripts/ensure-build-index.mjs dist/mineo mineo.html",
    "build:minprocesrente": "vite build --config vite.minprocesrente.config.ts && node scripts/ensure-build-index.mjs dist/minprocesrente minprocesrente.html && node scripts/cleanup-minprocesrente-public.mjs dist/minprocesrente",
    "build:all": "npm run build:mineo && npm run build:minprocesrente",
    "preview": "vite preview",
    "prepare": "husky",
    "generate:build-info": "node scripts/generate-build-info.mjs",
    "predev": "npm run generate:build-info",
    "predev:minprocesrente": "npm run generate:build-info",
    "prebuild:mineo": "npm run generate:build-info",
    "prebuild:minprocesrente": "npm run generate:build-info",
    "pretypecheck": "npm run generate:build-info",
    "pretypecheck:test": "npm run generate:build-info",
    "pretest": "npm run generate:build-info",
    "generate:icons": "node scripts/generate-pwa-icons.js",
    "check:filename-case": "node scripts/check-filename-case.mjs",
    "check:mojibake": "node scripts/check-mojibake.mjs",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=100%",
    "test:watch": "vitest",
    "import:loen": "node scripts/import-offentlig-loen.mjs",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "check": "npm run typecheck && npm run typecheck:test && npm run test"
  },
  "overrides": {
    "dompurify": "^3.4.5",
    "flatted": "^3.4.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "wrangler": "^4.94.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260625.1": true
  }
}
