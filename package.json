{
  "name": "mineo",
  "version": "0.9.6-b",
  "description": "Mineo - Web-baseret erstatningsberegner til EAL- og ASL-opgørelser",
  "author": "Bjørn Elling",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BjornElling/mineo.git"
  },
  "keywords": [
    "erstatning",
    "erstatningsopgørelse",
    "erstatningsberegner",
    "EAL",
    "erstatningsansvarsloven",
    "ASL",
    "arbejdsskadesikringsloven"
  ],
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=12.2.2 <13"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.13.0 <27",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/montserrat": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "docx": "9.7.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "scripts": {
    "dev": "vite --config vite.mineo.config.ts --open /",
    "dev:e2e": "vite --config vite.mineo.config.ts --host 127.0.0.1",
    "dev:minprocesrente": "vite --config vite.minprocesrente.config.ts --open /minprocesrente.html",
    "build": "npm run build:mineo",
    "build:mineo": "vite build --config vite.mineo.config.ts && node scripts/verify-build-artifacts.mjs mineo dist/mineo",
    "build:minprocesrente": "vite build --config vite.minprocesrente.config.ts && node scripts/ensure-build-index.mjs dist/minprocesrente minprocesrente.html && node scripts/cleanup-minprocesrente-public.mjs dist/minprocesrente && node scripts/verify-build-artifacts.mjs minprocesrente dist/minprocesrente",
    "build:all": "npm run build:mineo && npm run build:minprocesrente",
    "preview": "vite preview --config vite.mineo.config.ts",
    "preview:minprocesrente": "vite preview --config vite.minprocesrente.config.ts",
    "prepare": "husky",
    "generate:build-info": "node scripts/generate-build-info.mjs",
    "predev": "npm run generate:build-info",
    "predev:e2e": "npm run generate:build-info",
    "predev:minprocesrente": "npm run generate:build-info",
    "prebuild:mineo": "npm run generate:build-info",
    "prebuild:minprocesrente": "npm run generate:build-info",
    "pretypecheck": "npm run generate:build-info",
    "pretypecheck:test": "npm run generate:build-info",
    "pretest": "npm run check:types",
    "pretest:watch": "npm run check:types",
    "generate:icons": "node scripts/generate-pwa-icons.js",
    "check:filename-case": "node scripts/check-filename-case.mjs",
    "check:line-endings": "node scripts/check-line-endings.mjs",
    "fix:line-endings": "node scripts/check-line-endings.mjs --fix",
    "check:mojibake": "node scripts/check-mojibake.mjs",
    "verify:ledgers": "node scripts/architecture/verify-input-ledgers.mjs",
    "check:commit-msg": "node scripts/check-commit-msg.mjs",
    "check:runtime": "node scripts/check-runtime-version.mjs",
    "check:package-manifest": "npm ci --dry-run --ignore-scripts && node scripts/check-package-manifest.mjs",
    "check:tool-isolation": "node scripts/check-tool-isolation.mjs",
    "tools:install": "npm --prefix .agents/tools install --no-audit --no-fund",
    "check:vulnerabilities": "node scripts/check-vulnerabilities.mjs",
    "check:dependencies": "npm run check:package-manifest && npm run check:tool-isolation && npm run check:vulnerabilities",
    "check:github-actions-runtime": "node scripts/check-github-actions-runtime.mjs",
    "check:contract-verification": "node scripts/check-contract-verification.mjs",
    "check:types": "npm run generate:build-info && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.e2e.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check:quality": "node scripts/run-vitest.mjs run src/__tests__/quality",
    "check:commit": "npm run check:types && npm run lint && npm run check:quality",
    "lint": "eslint src e2e playwright.config.ts --max-warnings 0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "test": "node scripts/run-vitest.mjs run --maxWorkers=100%",
    "test:file": "node scripts/run-vitest.mjs run",
    "test:mutation": "stryker run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:headed": "node scripts/run-e2e.mjs --headed",
    "test:e2e:full": "node scripts/run-e2e.mjs --full",
    "check:e2e-lanes": "node scripts/check-e2e-lane-tags.mjs",
    "check:e2e-load": "node scripts/check-e2e-load.mjs",
    "preview:e2e": "vite preview --config vite.mineo.config.ts --host 127.0.0.1 --port 4174",
    "test:watch": "node scripts/run-vitest.mjs",
    "pretest:coverage": "npm run check:types",
    "test:coverage": "node scripts/run-vitest.mjs run --coverage --maxWorkers=100%",
    "import:loen": "node scripts/import-offentlig-loen.mjs",
    "check:offentlig-loen": "node scripts/import-offentlig-loen.mjs --check",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "verify:release:core": "npm run check:line-endings && npm run check:dependencies && npm run check:runtime && npm run check:github-actions-runtime && npm run check:types && npm run lint && npm run check:mojibake && npm run check:filename-case && npm run check:offentlig-loen && npm run check:contract-verification && npm run check:e2e-lanes && npm run check:e2e-load && npm run verify:ledgers && npm run test:coverage --ignore-scripts && npm run build:all",
    "verify:release": "npm run verify:release:core && npm run test:e2e",
    "check": "npm run verify:release"
  },
  "overrides": {
    "minimatch": "11.0.5",
    "qs": "6.17.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@stryker-mutator/core": "^10.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
