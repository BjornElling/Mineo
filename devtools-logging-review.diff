 const captureIssue = (payload: Omit<DevtoolsIssue, 'id' | 'timestamp'>): void => {
+  if (shouldIgnoreIssue(payload)) return;
   const stackLine = payload.stack ? payload.stack.split('\n')[0] ?? '' : '';
