+  const match = filename.match(EXTENSION_REGEX);
+  const extension = match?.[1]?.toLowerCase();
+  const hash = hashString(filename);
+  const prefix = extension ? `.${extension} fil` : 'fil';
+  return `${prefix} (navn-hash ${hash})`;
