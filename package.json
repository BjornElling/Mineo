{
  "name": "mineo",
  "version": "0.9.2-a",
  "description": "Mineo - Web-baseret erstatningsberegner til EAL- og ASL-opgørelser",
  "author": "Bjørn Elling",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BjornElling/mineo.git"
  },
  "keywords": [
    "erstatning",
    "erstatningsopgørelse",
    "erstatningsberegner",
    "EAL",
    "erstatningsansvarsloven",
    "ASL",
    "arbejdsskadesikringsloven"
  ],
  "private": true,
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@fontsource/montserrat": "^5.2.8",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "scripts": {
    "dev": "vite --config vite.mineo.config.ts --open /mineo.html",
    "dev:minprocesrente": "vite --config vite.minprocesrente.config.ts --open /minprocesrente.html",
    "build": "npm run build:mineo",
    "build:mineo": "vite build --config vite.mineo.config.ts && node scripts/ensure-build-index.mjs dist/mineo mineo.html",
    "build:minprocesrente": "vite build --config vite.minprocesrente.config.ts && node scripts/ensure-build-index.mjs dist/minprocesrente minprocesrente.html && node scripts/cleanup-minprocesrente-public.mjs dist/minprocesrente",
    "build:all": "npm run build:mineo && npm run build:minprocesrente",
    "preview": "vite preview",
    "prepare": "husky",
    "generate:icons": "node scripts/generate-pwa-icons.js",
    "check:filename-case": "node scripts/check-filename-case.mjs",
    "check:mojibake": "node scripts/check-mojibake.mjs",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=25%",
    "test:watch": "vitest",
    "import:loen": "node scripts/import-offentlig-loen.mjs"
  },
  "overrides": {
    "dompurify": "^3.3.3",
    "flatted": "^3.4.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.2.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "^4.0.18",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
